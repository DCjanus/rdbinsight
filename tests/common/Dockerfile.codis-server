# syntax=docker/dockerfile:1

ARG CODIS_VERSION=3.2.2
ARG CODIS_SOURCE_SHA256=ecd4e17763e4fa4cf5c003940b877dea7987c9b25ab1a2e9c30cd633c06cfcea
FROM debian:trixie AS builder

ARG CODIS_VERSION
ARG CODIS_SOURCE_SHA256
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        axel \
        build-essential \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build

RUN set -eux; \
    axel -n 8 -o codis.tar.gz "https://github.com/CodisLabs/codis/archive/refs/tags/${CODIS_VERSION}.tar.gz"; \
    echo "${CODIS_SOURCE_SHA256}  codis.tar.gz" | sha256sum -c -; \
    mkdir codis; \
    tar -xzf codis.tar.gz --strip-components=1 -C codis; \
    make -C codis -j"$(nproc)" codis-server; \
    install -d /opt/codis/bin; \
    install -m 0755 codis/bin/codis-server /opt/codis/bin/codis-server; \
    install -m 0755 codis/bin/redis-cli /opt/codis/bin/redis-cli

FROM debian:trixie-slim AS runtime

ARG CODIS_VERSION

COPY --from=builder /opt/codis /opt/codis

ENV PATH="/opt/codis/bin:${PATH}"

WORKDIR /data
VOLUME ["/data"]

EXPOSE 6379

CMD ["/opt/codis/bin/codis-server"]

LABEL org.opencontainers.image.source="https://github.com/CodisLabs/codis" \
      org.opencontainers.image.version="${CODIS_VERSION}"
