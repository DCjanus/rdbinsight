# syntax=docker/dockerfile:1

ARG CODIS_COMMIT=de1ad026e329561c22e2a3035fbfe89dc7fef764
FROM debian:trixie AS builder

ARG CODIS_COMMIT
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        axel \
        build-essential \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build

RUN set -eux; \
    axel -n 8 -o codis.tar.gz "https://github.com/CodisLabs/codis/archive/${CODIS_COMMIT}.tar.gz"; \
    mkdir codis; \
    tar -xzf codis.tar.gz --strip-components=1 -C codis; \
    make -C codis -j"$(nproc)" codis-server; \
    install -d /opt/codis/bin; \
    install -m 0755 codis/bin/codis-server /opt/codis/bin/codis-server; \
    install -m 0755 codis/bin/redis-cli /opt/codis/bin/redis-cli

FROM debian:trixie-slim AS runtime

ARG CODIS_COMMIT

COPY --from=builder /opt/codis /opt/codis

ENV PATH="/opt/codis/bin:${PATH}"

WORKDIR /data
VOLUME ["/data"]

EXPOSE 6379

CMD ["/opt/codis/bin/codis-server"]

LABEL org.opencontainers.image.source="https://github.com/CodisLabs/codis" \
      org.opencontainers.image.revision="${CODIS_COMMIT}"
